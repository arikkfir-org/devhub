# Cobranch's GraphQL schema, written first: internal/adapters/graphql generates its resolvers' types from it. It is the
# Console's surface (https://github.com/arikkfir-org/cobranch/blob/main/docs/cobranch/designs/architecture.md, "API conventions").

"An instant, as RFC 3339."
scalar Time

type Query {
  "The version of Cobranch that serves this installation: a release version or a commit's short SHA."
  version: String!
  "Who the request's credential signs in, or null for Anonymous."
  viewer: User
}

type Mutation {
  "Revokes one of the viewer's sessions; the next request with its cookie fails. False when the viewer has no such session."
  revokeSession(id: ID!): Boolean!
}

"A person: a principal of kind user."
type User {
  id: ID!
  displayName: String!
  "The emails the user holds; the sign-up's verified one today, several later."
  emails: [Email!]!
  "The user's live sessions, newest first."
  sessions: [Session!]!
}

type Email {
  email: String!
  verified: Boolean!
}

"A signed-in browser."
type Session {
  id: ID!
  createdAt: Time!
  lastSeenAt: Time!
  "When the session ends however it is used."
  expiresAt: Time!
  userAgent: String!
  ip: String!
  "Whether this is the session the request itself came with."
  current: Boolean!
}

"The scopes roles are granted at. Repositories come with their slice."
enum RoleScope {
  ORGANIZATION
}

extend type Query {
  "An organization by its slug, current or former: null unless the viewer may read it."
  organization(slug: String!): Organization
  "The permissions a role granted at a scope may hold, from the catalog."
  permissions(scope: RoleScope!): [String!]!
  "The built-in roles granted at a scope."
  roles(scope: RoleScope!): [Role!]! @deprecated(reason: "Roles are an organization's: Organization.roles lists them all. Removed two minor releases after 0.2.")
}

extend type User {
  "The permissions the viewer holds at the installation, such as orgs.create."
  permissions: [String!]!
  "The organizations the viewer belongs to."
  organizations: [Organization!]!
  "The pending invitations to the viewer's verified emails."
  invitations: [Invitation!]!
  "The viewer's pending requests to join organizations."
  joinRequests: [JoinRequest!]!
}

extend type Mutation {
  "Creates an organization and makes the viewer its Owner; takes orgs.create."
  createOrganization(slug: String!, name: String!): Organization!
  "Changes an organization's settings; takes org.manage. A new slug keeps the old one as an alias."
  updateOrganization(id: ID!, input: OrganizationSettings!): Organization!
  "Invites an email to the organization with a role; takes org.members.manage and the role's permissions."
  inviteMember(organizationId: ID!, email: String!, roleId: ID!): Invitation!
  "Cancels a pending invitation; takes org.members.manage."
  cancelInvitation(organizationId: ID!, id: ID!): Boolean!
  "Accepts an invitation to one of the viewer's verified emails, and joins the organization."
  acceptInvitation(id: ID!): Organization!
  "Declines an invitation to one of the viewer's verified emails."
  declineInvitation(id: ID!): Boolean!
  "Asks to join an organization that accepts join requests, by slug, with a note for its managers."
  requestToJoin(slug: String!, note: String): JoinRequest!
  "Approves a pending join request with a role; takes org.members.manage and the role's permissions."
  approveJoinRequest(organizationId: ID!, id: ID!, roleId: ID!): Boolean!
  "Declines a pending join request; takes org.members.manage."
  declineJoinRequest(organizationId: ID!, id: ID!): Boolean!
  "Leaves an organization. Its last Owner can't."
  leaveOrganization(id: ID!): Boolean!
  "Removes a member; takes org.members.manage and every permission of the roles they hold. Oneself is leaving."
  removeMember(organizationId: ID!, userId: ID!): Boolean!
  "Gives a member a role; takes org.grants.manage and every permission of the role."
  grantRole(organizationId: ID!, userId: ID!, roleId: ID!): Boolean!
  "Takes a role from a member; takes org.grants.manage and every permission of the role. The last Owner keeps Owner."
  revokeRole(organizationId: ID!, userId: ID!, roleId: ID!): Boolean!
  "Defines a custom role; takes org.grants.manage and every permission it lists."
  createRole(organizationId: ID!, input: RoleInput!): Role!
  "Redefines a custom role, and with it every grant of it; takes org.grants.manage and every permission it listed or lists."
  updateRole(organizationId: ID!, id: ID!, input: RoleInput!): Role!
  "Deletes a custom role nobody holds, cancelling the invitations that offered it; takes org.grants.manage and every permission of the role."
  deleteRole(organizationId: ID!, id: ID!): Boolean!
}

"An organization: a slug for its URLs, a name, and its settings."
type Organization {
  id: ID!
  slug: String!
  name: String!
  "The role everyone who joins gets: Member by default."
  membershipRoleId: ID!
  "Whether users may ask to join by slug. Off, the organization answers like one that doesn't exist."
  acceptsJoinRequests: Boolean!
  "The identity providers its members may sign in with, or null for all of the installation's."
  providers: [String!]
  createdAt: Time!
  "The permissions the viewer holds here."
  viewerPermissions: [String!]!
  "The members and the roles they hold; takes org.read."
  members: [Member!]!
  "The pending invitations; takes org.members.manage."
  invitations: [Invitation!]!
  "The pending join requests; takes org.members.manage."
  joinRequests: [JoinRequest!]!
  "The roles the organization grants: the built-in ones first, then its own; takes org.read."
  roles: [Role!]!
}

input OrganizationSettings {
  slug: String!
  name: String!
  membershipRoleId: ID!
  acceptsJoinRequests: Boolean!
  "Null or empty lets members sign in with any of the installation's providers."
  providers: [String!]
}

"A role granted at an organization: built in, or the organization's own."
type Role {
  id: ID!
  name: String!
  description: String!
  permissions: [String!]!
  builtIn: Boolean!
  "The organization a custom role belongs to; null on a built-in role."
  organizationId: ID
}

"A custom role's definition."
input RoleInput {
  name: String!
  description: String
  "From the permissions listed at scope ORGANIZATION; at least one."
  permissions: [String!]!
}

"A user who belongs to an organization, with the roles they hold there."
type Member {
  userId: ID!
  displayName: String!
  joinedAt: Time!
  roles: [Role!]!
}

"An invitation to an email; only a user who holds it, verified, accepts it."
type Invitation {
  id: ID!
  organizationId: ID!
  organizationSlug: String!
  organizationName: String!
  email: String!
  roleId: ID!
  "The role's name; empty once a custom role it offered is gone."
  roleName: String!
  createdAt: Time!
  expiresAt: Time!
}

"A user's request to join an organization, waiting for one of its member managers."
type JoinRequest {
  id: ID!
  organizationId: ID!
  organizationSlug: String!
  organizationName: String!
  userId: ID!
  userName: String!
  note: String!
  createdAt: Time!
  expiresAt: Time!
}
